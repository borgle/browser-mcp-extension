{
  "manifest_version": 3,
  "name": "ABM 浏览器助手",
  "description": "通过 ABM（a browser mcp） 把用户浏览器安全接入 AI，提供导航、填表、数据提取、网络抓包和文件投递能力。",
  "version": "2.0.0",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "key": "",
  "permissions": [
    "nativeMessaging",
    "tabs",
    "activeTab",
    "scripting",
    "storage",
    "webRequest",
    "webNavigation",
    "downloads",
    "alarms",
    "debugger",
    "tabGroups"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://*.borgle.io/*",
    "https://borgle.io/*",
    "https://*.weibo.com/*",
    "https://*.zhihu.com/*",
    "https://*.douyin.com/*",
    "https://*.bilibili.com/*",
    "https://*.xiaohongshu.com/*",
    "https://mp.weixin.qq.com/*"
  ],
  "optional_host_permissions": ["<all_urls>"],
  "externally_connectable": {
    "matches": [
      "https://*.borgle.io/*",
      "http://localhost:*/*",
      "http://127.0.0.1:*/*"
    ]
  },
  "web_accessible_resources": [{ "resources": ["/inject-scripts/*"], "matches": ["<all_urls>"] }],
  "background": { "service_worker": "src/background.js", "type": "module" },
  "action": { "default_title": "ABM 浏览器助手", "default_popup": "popup/popup.html" }
}
